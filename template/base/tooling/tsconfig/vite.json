{
    "$schema": "https://json.schemastore.org/tsconfig",
    "display": "Vite",
    "extends": "./base.json",
    "compilerOptions": {
        "jsx": "react-jsx",
        "lib": ["dom", "dom.iterable", "esnext"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "noEmit": true,
        "target": "esnext",
        "types": ["vite/client"]
    }
}
