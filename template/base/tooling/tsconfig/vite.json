{
    "$schema": "https://json.schemastore.org/tsconfig",
    "display": "Vite",
    "extends": "./base.json",
    "compilerOptions": {
        "allowJs": false,
        "esModuleInterop": false,
        "isolatedModules": true,
        "jsx": "react-jsx",
        "lib": ["DOM", "DOM.Iterable", "ESNext"],
        "allowImportingTsExtensions": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "noEmit": true,
        "resolveJsonModule": true,
        "strict": true,
        "target": "ESNext",
        "types": ["vite/client"]
    }
}
