        "@repo/tsconfig": "*",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/morgan": "^1.9.9",
        "tsup": "^8.3.6",
        "typescript": "^5.7.3"
    }
