{
    "name": "create-mono",
    "version": "1.0.0",
    "description": "Initialize your monorepos with ease.",
    "lisence": "MIT",
    "author": "Kulvir Singh",
    "repository": {
        "type": "git",
        "url": "https://github.com/kulvirdotgg/create-mono",
        "directory": "src"
    },
    "keywords": [
        "create-mono",
        "turborepo"
    ],
    "type": "module",
    "exports": "./dist/index.js",
    "bin": {
        "create-mono": "./dist/index.js"
    },
    "scripts": {
        "build": "tsup",
        "dev": "bun src/index.ts",
        "pretty": "prettier '**/*.{cjs,mjs,ts,tsx,md,json}' --write",
        "pretty:check": "prettier '**/*.{cjs,mjs,ts,tsx,md,json}' --check",
        "start": "bun dist/index.js",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@clack/prompts": "^0.7.0",
        "chalk": "^5.4.1",
        "execa": "^9.6.0",
        "figlet": "^1.8.1",
        "fs-extra": "^11.3.0",
        "ora": "^8.2.0",
        "sort-package-json": "^2.15.1"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "@types/figlet": "^1.7.0",
        "@types/fs-extra": "^11.0.4",
        "prettier": "^3.6.2",
        "tsup": "^8.5.0",
        "typescript": "^5.8.3"
    },
    "packageManager": "bun@1.2.2"
}
